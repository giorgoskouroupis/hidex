#!/bin/sh
# hx: tIDEx's Helix, with its runtime and tIDEx's settings (share/tidex/xdg/helix), never the machine's; through
# TIDEX_SHARE when set, so :config-reload after /update reads the newer ones
h=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
XDG_CONFIG_HOME=${TIDEX_SHARE:-$h/share/tidex}/xdg HELIX_RUNTIME=$h/tools/helix/runtime
export XDG_CONFIG_HOME HELIX_RUNTIME
exec "$h/tools/helix/hx" "$@"
