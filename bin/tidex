#!/bin/sh
# tidex [--side claude|shell|none] [host:]path [more paths]: tIDEx in path, as a zellij session named after
# it. Every path gets its own tree (stacked), locked to it; Helix, the shell and the side terminal work in
# the first one. --side: what the side terminal starts with (default: Claude if installed), or no side pane.
# A live session (window closed, ssh dropped) is reattached; a dead one is replaced, not revived.
# tidex --version; tidex --uninstall removes tIDEx and everything it brought (tidex-uninstall).
# host:path runs the server's tIDEx there (the other paths are then on the server too).
side=claude
[ "$1" = --side ] && { side=$2; shift 2; }
case ${1:-.} in
  *:*) h=${1%%:*} d=${1#*:}; shift
       exec ssh -t "$h" "cd $d && if [ -x ~/.local/bin/tidex ]; then exec ~/.local/bin/tidex --side $side . $*;
         else echo 'tIDEx is not installed here: curl -fsSL https://raw.githubusercontent.com/giorgoskouroupis/tidex/main/install.sh | sh'; fi" ;;
esac

# tIDEx's own folder (this script's, links followed): its scripts and tools come first, its settings are used
TIDEX_HOME=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
h=$TIDEX_HOME
PATH=$h/bin:$h/tools/bin:$PATH TIDEX_SHARE=$h/share/tidex TIDEX_PLUGIN=$h/share/tidex/tidex-panes.wasm
LG_CONFIG_FILE=$h/share/tidex/lazygit.yml YAZI_CONFIG_HOME=$h/share/tidex/xdg/yazi ZELLIJ_CONFIG_DIR=$h/share/tidex
# pudb for breakpoint() and python -m pudb in any env (share/tidex/python/sitecustomize.py)
PYTHONPATH=$h/share/tidex/python${PYTHONPATH:+:$PYTHONPATH} PYTHONBREAKPOINT=pudb.set_trace
export TIDEX_HOME PATH TIDEX_SHARE TIDEX_PLUGIN LG_CONFIG_FILE YAZI_CONFIG_HOME ZELLIJ_CONFIG_DIR
export PYTHONPATH PYTHONBREAKPOINT
case ${1:-} in
  --version) cat "$h/VERSION"; exit ;;
  --uninstall) shift; exec tidex-uninstall "$@" ;;
esac
# a newer release: offered (tidex-check-update); installed, the new one starts instead
tidex-check-update
if [ $? = 10 ]; then exec "${TIDEX_PREFIX:-$HOME/.local}/bin/tidex" "$@"; fi
tidex-guard "${1:-.}" "$@" || exit 1
cd "${1:-.}" || exit 1
[ $# -gt 0 ] && shift
# named after the folder and its parent (e.g. code-myproject): two folders with the same name do not collide
n=$(basename "$(dirname "$PWD")")-$(basename "$PWD")
export TIDEX_SIDE=$side
# every pane, pop-up and command of the session (the plugin's too) finds its session here: no script takes it
# as an argument
export ZELLIJ_SESSION_NAME=$n
# what is kept for the project between sessions (themes, the Python picked), in ~/.local/state
TIDEX_PROJECT=${XDG_STATE_HOME:-$HOME/.local/state}/tidex/projects/$n-$(printf %s "$PWD" | md5sum | cut -c1-8)
export TIDEX_PROJECT
mkdir -p "$TIDEX_PROJECT"
s=$(tidex-state)
# the window's terminal, for live colour themes (tidex-theme); reset to its own colours when tIDEx ends
tty > "$s/tty" 2>/dev/null || rm -f "$s/tty"
end() { tidex-theme off; }
# zellij from outside the session: with its name set, zellij takes us for inside it, and refuses to delete it
# or attach to it
outside() { env -u ZELLIJ_SESSION_NAME zellij "$@"; }
case $(outside ls -n 2>/dev/null | grep "^$n ") in
  *EXITED*) outside delete-session --force "$n" >/dev/null 2>&1 ;;
  ?*) running=1 ;;
esac
# a running session: one from an older tIDEx first moves to this one, as /update does (so nothing in it keeps
# needing the old one); one that cannot move (another zellij, or from before /update) is offered for removal,
# else attached as it is
# with the session's own zellij: a newer one may refuse to talk to its older server
attach() {
  z=$s/current/tools/bin/zellij; [ -x "$z" ] || z=zellij
  # messages to its bar at its own address (the one through its "current" link)
  TIDEX_PLUGIN=$s/current/share/tidex/tidex-panes.wasm tidex-theme apply
  env -u ZELLIJ_SESSION_NAME "$z" attach "$n"; end; exit
}
if [ -n "$running" ]; then
  [ "$(readlink -f "$s/current")" = "$TIDEX_HOME" ] && attach
  tidex-update "$TIDEX_HOME" >/dev/null 2>&1 && attach
  printf 'The session "%s" runs an older tIDEx that cannot be updated in place (its zellij differs, or it is from\nbefore /update).\n  y  remove it and start fresh (its running commands stop, unsaved Helix files are lost)\n  N  open it as it is (the default): finish your work, then quit and start tIDEx again\n> ' "$n"
  read -r answer
  [ "$answer" = y ] || attach
  outside kill-session "$n" >/dev/null 2>&1; outside delete-session --force "$n" >/dev/null 2>&1
fi

# a new session reaches its tIDEx through $s/current, which /update (tidex-update) moves to a newer one without
# a restart: every path to this tIDEx below goes through that link instead
c=$s/current
ln -sfn "$TIDEX_HOME" "$c"
swap() { printf '%s' "$1" | sed "s|$TIDEX_HOME|$c|g"; }
PATH=$(swap "$PATH") PYTHONPATH=$(swap "$PYTHONPATH") LG_CONFIG_FILE=$(swap "$LG_CONFIG_FILE")
YAZI_CONFIG_HOME=$(swap "$YAZI_CONFIG_HOME") TIDEX_SHARE=$c/share/tidex TIDEX_PLUGIN=$c/share/tidex/tidex-panes.wasm
ZELLIJ_CONFIG_DIR=$s/config
export PATH PYTHONPATH LG_CONFIG_FILE YAZI_CONFIG_HOME TIDEX_SHARE TIDEX_PLUGIN ZELLIJ_CONFIG_DIR
# the session's editor, fixed at its start (TIDEX_EDITOR, else the one chosen with /editor, else Neovim)
TIDEX_EDITOR=$(tidex-editor name) || exit 1
export TIDEX_EDITOR
tidex-config "$s"
tidex-zellij-setup

# the plugin runs in the bar, where zellij cannot ask for its permissions: approve them for this session's
# path (the same across /update), the same list as the plugin asks for (plugin/src/main.rs). The entry is
# written anew each start, so a permission added later is approved too; entries of tIDEx builds from before the
# session link go.
p=${XDG_CACHE_HOME:-$HOME/.cache}/zellij/permissions.kdl
mkdir -p "${p%/*}"; touch "$p"
awk -v this="\"$TIDEX_PLUGIN\" {" '$0 == this || /^"\/nix\/store\/[^"]*-tidex-panes-[^"]*" \{/ { skip = 1; next }
  skip && /^\}/ { skip = 0; next } !skip' "$p" > "$p.new"
printf '"%s" {\n' "$TIDEX_PLUGIN" >> "$p.new"
for permission in ReadApplicationState ChangeApplicationState RunCommands WriteToStdin ReadCliPipes RunActionsAsUser; do
  printf '    %s\n' "$permission"
done >> "$p.new"
echo "}" >> "$p.new"
mv "$p.new" "$p"

# the project's window theme, else the terminal's own; the Python (tidex-python detect)
if [ -f "$TIDEX_PROJECT/theme" ]; then cp "$TIDEX_PROJECT/theme" "$s/theme"; tidex-theme apply; else rm -f "$s/theme"; fi
tidex-python detect
# what this machine's sandbox leaves unprotected, once: the bar warns of it (tidex-status), /about says what
tidex-sandbox --gaps > "$s/sandbox-gaps"
# the layout with one tree per folder, stacked; the first (code) tree is the open one
trees=$(x=" expanded=true"; for d in "$PWD" "$@"; do d=$(cd "$d" && pwd) || exit 1
  printf 'pane name="tree: %s" command="tidex-tree"%s { args "%s"; }\n' "$(basename "$d")" "$x" "$d"; x=; done) || exit 1
layout=$s/layout.kdl
# the welcome pop-up, until it has been seen once (tidex-welcome)
welcome=
[ -e "${XDG_STATE_HOME:-$HOME/.local/state}/tidex/welcomed" ] ||
  welcome='floating_panes { pane name="welcome" command="tidex-welcome" close_on_exit=true x="20%" y="15%" width="60%" height="50%"; }'
awk -v t="$trees" -v side="$side" -v plugin="$TIDEX_PLUGIN" -v welcome="$welcome" -v editor="$(tidex-editor title)" '/@TREES@/ && !/\/\// { print t; next }
  /@WELCOME@/ && !/\/\// { print welcome; next }
  side == "none" && /name="side 1"/ { next } side == "none" { sub(/ size="60%"/, "") } { gsub(/@plugin@/, plugin); gsub(/@EDITOR@/, editor); print }' \
  "$TIDEX_SHARE/layouts/tidex.kdl" > "$layout"
zellij -s "$n" -n "$layout"
end
