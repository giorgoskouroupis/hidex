#!/bin/sh
# hidex-helix-theme [pick | NAME | restore | list]: a theme of Helix's own, for Helix only, remembered for the
# project (HIDEX_PROJECT). "hidex" (or "terminal") is hIDEx's own, in the window's colours. pick: Helix's
# themes, previewed in Helix as you move; Enter keeps, Esc goes back. restore: the project's, once Helix runs
# (the bar asks for it at start).
mem=${HIDEX_PROJECT:+$HIDEX_PROJECT/helix-theme}
current() { cat "$mem" 2>/dev/null || echo hidex; }
keep() {
  hidex-msg helix "theme $1"
  [ -n "$mem" ] || return 0
  if [ "$1" = hidex ]; then rm -f "$mem"; else echo "$1" > "$mem"; fi
}
# hIDEx's own first, then every theme in Helix's runtime folders
themes() {
  echo hidex
  hx --health 2>/dev/null | sed -n 's/^Runtime directories: //p' | tr ';' '\n' |
    while read -r d; do ls "$d/themes" 2>/dev/null; done | sed -n 's/\.toml$//p' | sort -u
}
case ${1:-pick} in
  list) themes ;;
  restore)
    t=$(current)
    # Helix has only just started: give it a moment before typing into it
    [ "$t" = hidex ] || { sleep 1; hidex-msg helix "theme $t"; } ;;
  pick)
    was=$(current)
    t=$(themes | hidex-fzf --prompt 'helix theme > ' \
          --header "hidex: in the window's colours. Moving previews; Enter keeps, Esc goes back" \
          --bind 'focus:execute-silent(hidex-msg helix "theme {}")') || { hidex-msg helix "theme $was"; exit 0; }
    keep "$t" ;;
  terminal) keep hidex ;;
  *) keep "$1" ;;
esac
