#!/bin/sh
# hidex-copy SESSION PANE: copies the last command run in that terminal and its output, the command on top, to
# the clipboard (/copy; the plugin passes the terminal last used). Read from the screen: the bottom line is the
# prompt, so the last earlier line starting with it is the command; a header line above the prompt (two-line
# prompts) is left out. The clipboard is the window's, through the terminal (OSC 52), so it also works over ssh.
# hidex-copy --from FILE: only prints what would be copied from a saved screen (the tests).

# last FILE: the last command and its output, from a terminal's dumped text
last() {
  awk '{ line[NR] = $0 } END {
    n = NR; while (n > 0 && line[n] ~ /^[[:space:]]*$/) n--
    if (n < 2) exit
    prompt = line[n]; sub(/[[:space:]]+$/, "", prompt)
    for (c = n - 1; c > 0; c--) if (index(line[c], prompt " ") == 1) break
    if (c < 1) exit
    end = n - 1
    # a two-line prompt: its first line, shown again above the current prompt, is not output
    if (c > 1 && end > c && line[c - 1] != "" && substr(line[end], 1, 8) == substr(line[c - 1], 1, 8)) end--
    while (end > c && line[end] ~ /^[[:space:]]*$/) end--
    for (i = c; i <= end; i++) print line[i]
  }' "$1"
}

if [ "$1" = --from ]; then last "$2"; exit; fi
export ZELLIJ_SESSION_NAME=$1
s=$(hidex-state) || exit 1
dump=$s/copy.txt
zellij action dump-screen --pane-id "$2" --full --path "$dump" || exit 1
text=$(last "$dump")
[ -n "$text" ] || exit 0

hidex-osc "52;c;$(printf '%s\n' "$text" | base64 | tr -d '\n')"
