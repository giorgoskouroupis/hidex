#!/bin/sh
# hidex-zellij-setup: tells zellij (0.46 and later) not to offer itself as a desktop app: its setup wizard would
# otherwise open over every new hIDEx session and take the keys. The same as Ctrl+c ("don't show again") in the
# wizard, recorded in zellij's own state file; the file's other settings stay as they are.
f=${XDG_DATA_HOME:-$HOME/.local/share}/zellij/desktop_integration.json
grep -q '"SetupNeverShow"\|"SetupApproved"' "$f" 2>/dev/null && exit 0
mkdir -p "${f%/*}"
python3 - "$f" <<'PY'
import json, sys
path = sys.argv[1]
try:
    state = json.load(open(path))
except (OSError, ValueError):
    state = {}
flags = state.get("flags", [])
state["flags"] = flags + ["SetupNeverShow"]
json.dump(state, open(path, "w"))
PY
