#!/bin/sh
# hidex-tree DIR: broot locked to DIR. It runs in a bubblewrap sandbox that sees only DIR (read-only),
# the Nix store and zellij's socket, so going "up" finds nothing else and the tree cannot change a file.
# Files still open through hidex-open, which reaches Helix and lnav through zellij, outside the sandbox.
dir=$(cd "$1" && pwd) || exit 1
hidex-guard "$dir" || { sleep 5; exit 1; }
run=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
exec bwrap --die-with-parent --unshare-all \
  --ro-bind /nix /nix --ro-bind /etc /etc \
  --proc /proc --dev /dev --tmpfs /tmp --tmpfs "$HOME" \
  --bind "$run/zellij" "$run/zellij" \
  --ro-bind "$dir" "$dir" --chdir "$dir" \
  --setenv BR_INSTALL no --setenv HIDEX_TREE_TOP "$dir" --setenv HIDEX_TREE_SOCK hidex-tree \
  broot --conf "$HIDEX_SHARE/broot.hjson" --listen hidex-tree "$dir"
