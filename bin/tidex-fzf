#!/bin/sh
# tidex-fzf [FZF OPTIONS]: fzf in tIDEx's one look, for every list (the / commands, themes, Python envs,
# languages): the whole pop-up, the input at the top, one mark for the line Enter picks (a ▶, the whole line on
# grey, bold), matches in the accent colour only, little chrome. The scripts add only what is their own (prompt,
# columns, keys).
exec fzf --height 100% --reverse --no-scrollbar --info inline-right --pointer '▶' --marker ' ' --gutter ' ' --highlight-line \
  --color 'bg+:8,fg+:15:bold,pointer:3:bold,gutter:-1,hl:3,hl+:3:bold,prompt:3:bold,info:8,header:8,separator:8,query:-1:bold' \
  "$@"
