#!/usr/bin/env bash
# hidex-bg: the window's background and whether it is dark or light, as "#rrggbb dark|light": the /theme's
# background, else the terminal's own, as zellij answers when asked (OSC 11). Nothing if neither is known.
s=$(hidex-state 2>/dev/null) || exit 0
bg=
if [ -f "$s/theme" ]; then
  bg=$(awk '$1 == "background" { print $2 }' "$HIDEX_SHARE/themes/$(cat "$s/theme").conf" 2>/dev/null)
fi
if [ -z "$bg" ] && [ -r /dev/tty ]; then
  # the answer looks like ESC ] 11 ; rgb:1e1e/2020/2828 ESC \ : the first two hex digits of each part
  # straight to the terminal: this script's output is usually captured
  exec 3<>/dev/tty || exit 0
  old=$(stty -g <&3); stty raw -echo <&3
  printf '\033]11;?\033\\' >&3
  IFS= read -r -s -t 0.3 -d '\' answer <&3
  stty "$old" <&3; exec 3>&-
  if [[ $answer =~ rgb:([0-9a-fA-F]{2})[0-9a-fA-F]*/([0-9a-fA-F]{2})[0-9a-fA-F]*/([0-9a-fA-F]{2}) ]]; then
    bg="#${BASH_REMATCH[1]}${BASH_REMATCH[2]}${BASH_REMATCH[3]}"
  fi
fi
[ -z "$bg" ] && exit 0
r=$((16#${bg:1:2})) g=$((16#${bg:3:2})) b=$((16#${bg:5:2}))
if (( r * 299 + g * 587 + b * 114 < 128000 )); then echo "$bg dark"; else echo "$bg light"; fi
