#!/bin/sh
# hidex-welcome: the first start's pop-up, shown once (then ~/.local/state/hidex/welcomed): what nobody would
# guess, above all that Helix saves by itself when you leave it.
hidex-popup-colors
mark=${XDG_STATE_HOME:-$HOME/.local/state}/hidex/welcomed
mkdir -p "${mark%/*}" && touch "$mark"
cat <<'EOF'

  Welcome to hIDEx

  ! Helix saves by itself when you leave it (another pane, F2, a pop-up):
    nothing stays as an unsaved draft. u still undoes, and git shows what changed.

  Alt+k   every key, by group
  Alt+p   the / commands
  F2      on a file in a tree: open it with another editor (micro, nano)
  Alt+q   quit

  press a key
EOF
stty -icanon -echo; dd bs=1 count=1 >/dev/null 2>&1
