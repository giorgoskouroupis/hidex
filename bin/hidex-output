#!/bin/sh
# hidex-output SESSION PANE NAME: a terminal's whole output (scrollback and screen) opened in Helix, at its end,
# just after the last command's: select there and copy (Helix's space+y for the clipboard). The plugin passes
# the terminal last used (/output).
export ZELLIJ_SESSION_NAME=$1
s=$(hidex-state) || exit 1
mkdir -p "$s/output"
f=$s/output/$(printf %s "$3" | tr -c 'A-Za-z0-9_-' -).txt
zellij action dump-screen --pane-id "$2" --full --path "$f" || exit 1
# without the empty lines below the prompt
sed -i -e ':a' -e '/^[[:space:]]*$/{$d;N;ba' -e '}' "$f"
hidex-msg helix "open $f"
hidex-msg helix "goto $(wc -l < "$f")"
