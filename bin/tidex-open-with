#!/bin/sh
# tidex-open-with FILE: F2 on a file in a tree, in a pop-up: pick the editor (the main one, the others with an
# adapter, micro, nano when the system has it). The main one: as Enter does. Another, a guest: in the main
# editor's place (zellij's open in place, sandboxed the same), and the main editor is back when it quits. One
# guest holds that place at a time: while one does, Enter in a tree or yazi (tidex-open-with --held FILE) asks
# whether to close it first, the file then opening in the main editor; F2 offers the same list, the guest closing
# first for the main editor or for another guest (--after: that one opens once the guest has gone).
main=$(tidex-editor name) title=$(tidex-editor title)
adapters=${TIDEX_SHARE:-$(dirname "$(readlink -f "$0")")/../share/tidex}/editors

# the guest holding the place (tidex-panes guest: "ID<TAB>edit: a.py (micro)"): its pane id, file and editor
parse_held() {
  guest=${1#*	} id=${1%%	*} file=${guest#edit: } file=${file% (*} editor=${guest##*(} editor=${editor%)}
}
# close_guest [FILE [EDITOR]]: the guest leaves by its own quit (tidex-editor close: it asks about anything unsaved,
# the focus on it for that); once it has gone, FILE opens in the main editor (the bar: after-guest), or in EDITOR,
# another guest (run by the bar: a process left in this pop-up would go with it)
close_guest() {
  if [ -n "${2:-}" ]; then
    tidex-msg note "${1##*/}: $editor → $2…"
    tidex-msg detach "$(printf 'tidex-open-with\t--after\t%s\t%s\t%s' "$id" "$2" "$1")"
  elif [ -n "${1:-}" ]; then
    tidex-msg after-guest "open \"$1\""
  fi
  tidex-editor close "$editor" "$id"
  zellij action focus-pane-id "$id"
}
# who holds the place: y closes it (the file asked for then opens in the main editor), anything else goes back
handover() {
  parse_held "$1"
  answer=$(tidex-key "$(printf '%s is open in %s, in %s'"'"'s place.\n\nClose %s now? y: yes (it asks you first if anything is unsaved), \nanything else: back to %s' \
    "$file" "$editor" "$title" "$editor" "$editor")")
  if [ "$answer" = y ]; then close_guest "${2:-}"; else zellij action focus-pane-id "$id"; fi
}
# open_guest EDITOR FILE: EDITOR in the main editor's place (none: a new pane where there is room), focused; the
# bar reloads FILE in the main editor when it quits (the main one keeps it in memory meanwhile). An editor with an
# adapter runs through it (its settings, its sandbox), another one sandboxed as it is
open_guest() {
  tidex-msg handover "$2"
  pane=$(tidex-panes id "$title")
  if [ -x "$adapters/$1" ]; then run="env TIDEX_EDITOR=$1 tidex-editor run"; else run="tidex-sandbox machine -- $1"; fi
  # shellcheck disable=SC2086
  id=$(zellij action new-pane ${pane:+--in-place --pane-id "$pane"} --close-on-exit --name "edit: ${2##*/} ($1)" \
    --cwd "${2%/*}" -- $run "$2")
  [ -n "$id" ] && zellij action focus-pane-id "$id"
}

# --after ID EDITOR FILE: once the guest in pane ID has gone, EDITOR opens FILE in its place; still there after two
# minutes (a question left unanswered, a cancel): nothing opens. Said on the bar either way
if [ "$1" = --after ]; then
  if tidex-panes wait "$2" gone 120; then open_guest "$3" "$4"; tidex-msg note "${4##*/}: in $3"
  else tidex-msg note "the guest stayed: $3 not opened"; fi
  exit 0
fi

tidex-popup-colors
h=$(tidex-panes guest)
[ "$1" = --held ] && { shift; [ -n "$h" ] && { handover "$h" "${1:+$(realpath -- "$1")}"; exit 0; }; }
[ -n "$1" ] || { [ -n "$h" ] && handover "$h"; exit 0; }
f=$(realpath -- "$1") || exit 1
tidex-guard "$f" || { sleep 2; exit 1; }
# the main editor, then the other editors tIDEx has an adapter for (Helix, Neovim), then micro, nano; a guest
# holding the place is not offered again
[ -n "$h" ] && parse_held "$h"
editors=$(echo "$main"; ls "$adapters" | grep -vx "$main"; echo micro; command -v nano >/dev/null && echo nano)
editors=$(printf '%s\n' "$editors" | grep -vx "${editor:-}")
# Helix saves when left (its auto-save); an editor that answers (Neovim) is asked below instead
note=; [ "$main" = helix ] && note="
$title saved its changes when you left it: another editor opens the file as saved."
[ -n "$h" ] && note="
$editor holds $title's place ($file): it closes first, asking about anything unsaved."
pick=$(printf '%s\n' "$editors" | tidex-fzf --prompt 'open with ' --header "${f##*/} · Enter opens · Esc closes$note") ||
  exit 0
if [ "$pick" = "$main" ]; then
  # with a guest there: it closes, then the file opens in the main editor
  [ -n "$h" ] || exec tidex-open "$f"
  close_guest "$f"; exit 0
fi
# unsaved changes to it in the main editor: nothing handed over until they are saved
if [ "$(tidex-editor do modified "$f" 2>/dev/null)" = 1 ]; then
  tidex-key "$(printf '%s has unsaved changes in %s: save it there first (:w), then open it with %s.\n\npress a key' \
    "${f##*/}" "$title" "$pick")" >/dev/null
  exit 0
fi
if [ -n "$h" ]; then close_guest "$f" "$pick"; else open_guest "$pick" "$f"; fi
