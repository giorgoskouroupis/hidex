#!/bin/sh
# The yazi pop-up, sandboxed like the trees but able to change the project (tidex-sandbox write): it cannot
# wander into other folders. Files open through tidex-open, which reaches Helix and lnav through zellij.
tidex-popup-colors
tidex-guard "$PWD" || { sleep 5; exit 1; }
export EDITOR=tidex-open TIDEX_YAZI_ROOT="$PWD"
exec tidex-sandbox write "$PWD" -- yazi "$PWD"
