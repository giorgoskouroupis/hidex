#!/bin/sh
# hidex-shell [term|side]: what runs in a terminal or after Claude in a side terminal (named after what runs: zsh 1): a login
# shell in the project Python (hidex-env); when it exits, a new one if this is the last pane of its kind, else
# the pane closes.
kind=${1:-term}
# noted for hidex-running (Alt+q asks while a command runs here)
mkdir -p "$(hidex-state)/panes" && echo "$$" > "$(hidex-state)/panes/$ZELLIJ_PANE_ID"
while :; do
  hidex-env "${SHELL:-sh}" -l
  [ "$(hidex-panes "$kind" | wc -l)" -gt 1 ] &&
    exec zellij action close-pane -p "terminal_$ZELLIJ_PANE_ID"
done
