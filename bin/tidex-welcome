#!/bin/sh
# tidex-welcome: the first start's pop-up, shown once (then ~/.local/state/tidex/welcomed): what nobody would
# guess, above all about the editor (its adapter's notes: Helix saving when left, Neovim reloading…).
tidex-popup-colors
mark=${XDG_STATE_HOME:-$HOME/.local/state}/tidex/welcomed
mkdir -p "${mark%/*}" && touch "$mark"
printf '\n  Welcome to tIDEx, with %s as the editor (/editor picks another)\n\n' "$(tidex-editor title)"
tidex-editor notes | sed 's/^/  ! /'
cat <<'EOF2'

  Alt+k   every key, by group
  Alt+p   the / commands
  F2      on a file in a tree: open it with another editor (Helix or Neovim, micro, nano)
  F3 F4   in a tree: copy the path, absolute or relative
  Alt+q   quit

  press a key
EOF2
tidex-key >/dev/null
