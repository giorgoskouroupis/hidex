#!/bin/sh
# hidex-stop: stops what still runs in the session's shells before hIDEx ends, so nothing is left
# behind (on a server too): Ctrl+c first (SIGINT, programs clean up), then SIGTERM, then SIGKILL, a few seconds
# apart. What left the shells on its own (setsid, daemons, docker containers) is not reached.
pids() { hidex-running --pids | while read -r p; do kill -0 "$p" 2>/dev/null && echo "$p"; done; }
for sig in INT TERM KILL; do
  p=$(pids); [ -z "$p" ] && exit 0
  kill -s $sig $p 2>/dev/null
  for _ in 1 2 3 4 5 6; do [ -z "$(pids)" ] && exit 0; sleep 0.5; done
done
