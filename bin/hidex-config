#!/bin/sh
# hidex-config [STATE]: writes the session's zellij config (STATE/config/config.kdl; default: this session's) from
# hIDEx's, with the plugin's path filled in: the one through the session's "current" link, so keys keep reaching
# the bar after /update. zellij re-reads the file when it changes.
[ -n "${1:-}" ] || set -- "$(hidex-state)"
share=$1/current/share/hidex
# no session (a script run on its own): nothing to write
[ -f "$share/config.kdl" ] || exit 0
mkdir -p "$1/config"
sed "s|@plugin@|$share/hidex-panes.wasm|g" "$share/config.kdl" > "$1/config/config.kdl"
