#!/bin/sh
# hidex-python [pick | set PREFIX | detect | label]: the project's Python, the one Helix checks the code
# against (hidex-pyright), new shells start in (hidex-env) and the bar shows. detect (at start): the env active
# when hidex was run (micromamba, conda, a virtualenv), else the project's .venv or venv. pick: choose among
# the envs found, grouped: the project's, micromamba, conda, other virtualenvs (poetry, virtualenvwrapper).
# set PREFIX: an env folder, or "none" for hIDEx's own Python.
s=$(hidex-state) || exit 1

# version PREFIX: the env's Python version, read from its files (running every python is slow)
version() {
  v=$(ls "$1"/conda-meta/python-[0-9]*.json 2>/dev/null | sed -n 's|.*/python-\([0-9]*\.[0-9]*\).*|\1|p' | head -1)
  [ -z "$v" ] && v=$(sed -n 's/^version[_a-z]* *= *\([0-9]*\.[0-9]*\).*/\1/p' "$1/pyvenv.cfg" 2>/dev/null | head -1)
  echo "$v"
}
# kind PREFIX: what made a project env
kind() {
  if grep -q '^uv *=' "$1/pyvenv.cfg" 2>/dev/null; then echo uv
  elif [ -d "$1/conda-meta" ]; then echo conda
  else echo venv; fi
}
# each group: GROUP<TAB>NAME<TAB>PREFIX, one line per env
project_envs() {
  root=$(git rev-parse --show-toplevel 2>/dev/null)
  for d in "$PWD" ${root:+"$root"}; do for v in .venv venv env; do
    [ -x "$d/$v/bin/python" ] && printf 'project\t%s (%s)\t%s\n' "${d##*/}/$v" "$(kind "$d/$v")" "$d/$v"
  done; done
}
manager_envs() {
  command -v "$1" >/dev/null &&
    "$1" env list 2>/dev/null | awk -v g="$1" '/^[^#]/ && $NF ~ /^\// { print g "\t" $1 "\t" $NF }'
}
other_envs() {
  for d in "${WORKON_HOME:-$HOME/.virtualenvs}" "$HOME/.cache/pypoetry/virtualenvs"; do
    for p in "$d"/*/; do p=${p%/}; [ -x "$p/bin/python" ] && printf 'virtualenvs\t%s\t%s\n' "${p##*/}" "$p"; done
  done
}
# the list for fzf: a header line per group, then its envs (version, ● on the current one); hidden fields
# after the first: group (for filtering) and folder
listing() {
  cur=$(cat "$s/python" 2>/dev/null)
  { project_envs; manager_envs micromamba; manager_envs conda; other_envs
    printf 'hIDEx\thIDEx'"'"'s own Python\tnone\n'; } |
  awk -F"\t" '!seen[$3]++' | while IFS="$(printf '\t')" read -r g n p; do
    [ "$p" = none ] || [ -x "$p/bin/python" ] || continue
    [ "$g" != "$last" ] && printf '\033[1;33m── %s\033[0m\t%s\t\n' "$g" "$g" && last=$g
    m=" "; [ "$p" = "${cur:-none}" ] && m="●"
    printf '  %s %-30s \033[2m%s\033[0m\t%s\t%s\n' "$m" "$n" "$(if [ "$p" = none ]; then python3 -c "import sys; print(\"%d.%d\" % sys.version_info[:2])"; else version "$p"; fi)" "$g" "$p"
  done
}

# set_prefix PREFIX [quiet]: quiet at start, before the session (Helix, the bar) exists
set_prefix() {
  if [ "$1" = none ] || [ ! -x "$1/bin/python" ]; then rm -f "$s/python" "$s/python-label"
  else
    echo "$1" > "$s/python"
    echo "$(basename "$1") $(version "$1")" > "$s/python-label"
  fi
  [ -n "$2" ] && return
  hidex-msg helix lsp-restart >/dev/null 2>&1
  hidex-msg status >/dev/null 2>&1
}
case ${1:-pick} in
  detect)
    for p in "$CONDA_PREFIX" "$VIRTUAL_ENV" "$PWD/.venv" "$PWD/venv"; do
      [ -n "$p" ] && [ -x "$p/bin/python" ] && { set_prefix "$p" quiet; exit; }
    done
    set_prefix none quiet ;;  # nothing found: not the choice of an earlier session
  set) set_prefix "$2" ;;
  label) cat "$s/python-label" 2>/dev/null ||
         echo "hIDEx $(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null)" ;;
  pick)
    # a group's header line picks nothing; typing filters on names and group names
    choice=$(listing | fzf --ansi --no-sort --prompt 'python > ' --delimiter '\t' --with-nth 1 --nth 1,2 \
      --height 100% --reverse) || exit 0
    p=$(printf '%s' "$choice" | cut -f3)
    [ -n "$p" ] && set_prefix "$p" ;;
esac
