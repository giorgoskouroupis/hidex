#!/bin/sh
# tidex-config [STATE]: writes the session's zellij config (STATE/config/config.kdl; default: this session's) from
# tIDEx's, filled in: the plugin's path through the session's "current" link (so keys keep reaching the bar after
# /update), and the frame colours you chose (tidex-frames). zellij re-reads the file when it changes.
[ -n "${1:-}" ] || set -- "$(tidex-state)"
share=$1/current/share/tidex
# no session (a script run on its own): nothing to write
[ -f "$share/config.kdl" ] || exit 0
mkdir -p "$1/config"
# a palette number as it is, "#rrggbb" quoted
frames=${XDG_STATE_HOME:-$HOME/.local/state}/tidex/frames
colour() { awk -v w="$1" '$1 == w { print ($2 ~ /^#/ ? "\"" $2 "\"" : $2) }' "$frames" 2>/dev/null; }
focused=$(colour focused) unfocused=$(colour unfocused)
sed "s|@plugin@|$share/tidex-panes.wasm|g
  /frame_selected/ s|base 3;|base ${focused:-3};|; /frame_unselected/ s|base 8;|base ${unfocused:-8};|" \
  "$share/config.kdl" > "$1/config/config.kdl"
