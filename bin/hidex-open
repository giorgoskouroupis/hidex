#!/bin/sh
# Open files picked in broot (the tree, Helix is right of it) or in the yazi pop-up (--popup):
# logs and anything over 10 MB in lnav (read-only, made for GB logs) as a large pop-up; the rest in Helix,
# by typing :open into its pane (the trick from zide).
[ "$1" = --popup ] && { popup=1; shift; }
for f in "$@"; do
  case $f in *.log|*.log.*|*.out|*.err) big=1 ;; esac
  [ "$(stat -c %s "$f" 2>/dev/null || echo 0)" -gt 10485760 ] && big=1
done
if [ -n "$big" ]; then
  [ -n "$popup" ] && zellij action toggle-floating-panes
  exec zellij run --floating --close-on-exit --name "$(basename "$1")" \
    --width 90% --height 85% -x 5% -y 5% -- lnav -I "$HIDEX_SHARE/lnav" "$@"
fi
if [ -n "$popup" ]; then zellij action toggle-floating-panes; else zellij action move-focus right; fi
zellij action write 27
zellij action write-chars ":open $*"
zellij action write 13
