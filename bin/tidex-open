#!/bin/sh
# Open files picked in a tree or in yazi: logs and anything over 10 MB in lnav (read-only, made for GB logs)
# as a pop-up; the rest in Helix, which the tIDEx plugin types ":open" into, one key group at a time.
# Files in off-limits folders (tidex-guard) are refused.
[ "$1" = --popup ] && shift # older callers; pop-ups are handled by the plugin now
# --with: pick the editor first (F2 in a tree), in a pop-up
[ "$1" = --with ] && exec zellij run --floating --close-on-exit --name "open with" -- tidex-open-with "$2"
tidex-guard "$@" || { sleep 2; exit 1; }
for f in "$@"; do
  case $f in *.log|*.log.*|*.out|*.err) big=1 ;; esac
  [ "$(stat -c %s "$f" 2>/dev/null || echo 0)" -gt 10485760 ] && big=1
done
if [ -n "$big" ]; then
  exec zellij run --floating --close-on-exit --name "$(basename "$1")" -- lnav -I "$TIDEX_SHARE/lnav" "$@"
fi
# a guest editor holds the main editor's place (tidex-open-with): a pop-up asks whether to close it first
if [ -n "$(tidex-panes guest)" ]; then
  exec zellij run --floating --close-on-exit --name "open with" -- tidex-open-with --held "$(realpath -- "$1")"
fi
# paths with spaces: Helix's :open takes quoted arguments
args=
for f in "$@"; do args="$args \"$(realpath -- "$f")\""; done
exec tidex-msg editor "open$args"
