#!/bin/sh
# hidex-theme NAME | pick | reset | list | apply | off | preview NAME: recolours the window hIDEx runs
# in, live. Every hIDEx colour is one of the terminal's 16, so zellij, Helix (unless given its own theme), the
# trees, lazygit and pudb all follow (Claude Code keeps its own). The colour codes go straight to the window
# (hidex-osc). Schemes: iTerm2-Color-Schemes' kitty files (share/hidex/themes). pick: favourites, then every dark
# and light scheme, previewed as you move. reset: the terminal's own colours. apply: the session's theme again
# (hidex does it on reattach). off: the terminal's own colours, keeping the choice (hidex, on leaving).
themes=$HIDEX_SHARE/themes
FAVOURITES='Atom One Dark
Dracula
Catppuccin Mocha
TokyoNight
Nord
Gruvbox Dark
Rose Pine
Catppuccin Latte
One Half Light
Gruvbox Light'
# the codes that give the terminal its own colours back
RESET='104 110 111 112 117 119'

case ${1:-list} in
  list) ls "$themes" | sed -n 's/\.conf$//p'; exit ;;
esac
s=$(hidex-state) || exit 1

# codes NAME: the scheme's colours as terminal codes (kitty format: "colorN #hex", "background #hex"…)
codes() {
  awk '$1 ~ /^color[0-9]+$/ { print "4;" substr($1, 6) ";" $2 }
    $1 == "foreground" { print "10;" $2 } $1 == "background" { print "11;" $2 } $1 == "cursor" { print "12;" $2 }
    $1 == "selection_background" { print "17;" $2 } $1 == "selection_foreground" { print "19;" $2 }' "$themes/$1.conf"
}
paint() {
  [ -f "$themes/$1.conf" ] || { echo "hIDEx: no theme $1 (hidex-theme list)" >&2; return 1; }
  hidex-osc $RESET $(codes "$1")
}
reset() { hidex-osc $RESET; }
# back to the session's theme, or the terminal's own colours
restore() { if [ -f "$s/theme" ]; then paint "$(cat "$s/theme")"; else reset; fi; }

# the list for fzf: group headers, then names; the hidden 2nd field is the scheme to preview (empty on headers)
listing() {
  h() { printf '\033[1;33m── %s\033[0m\t\n' "$1"; }
  printf '  reset (the terminal'"'"'s own colours)\treset\n'
  h favourites; printf '%s\n' "$FAVOURITES" | awk '{ print "  " $0 "\t" $0 }'
  # dark or light by the background (brightness.awk)
  awk -f "$HIDEX_SHARE/brightness.awk" -e '/^background/ { n = FILENAME; sub(/.*\//, "", n); sub(/\.conf$/, "", n)
      print mode($2) "\t" n }' "$themes"/*.conf |
    sort -t "$(printf '\t')" -k1,1 -k2,2f |
    awk -F'\t' '$1 != last { printf "\033[1;33m── %s\033[0m\t\n", $1; last = $1 } { print "  " $2 "\t" $2 }'
}

case $1 in
  reset) reset; rm -f "$s/theme" ${HIDEX_PROJECT:+"$HIDEX_PROJECT/theme"} ;;
  apply) [ -f "$s/theme" ] && paint "$(cat "$s/theme")" ;;
  off) [ -f "$s/theme" ] && reset ;;
  preview) case $2 in reset) reset ;; '') ;; *) paint "$2" ;; esac ;;
  pick)
    choice=$(listing | fzf --ansi --no-sort --prompt 'theme > ' --delimiter '\t' --with-nth 1 \
      --height 100% --reverse --header 'moving previews; Enter keeps, Esc goes back' \
      --bind 'focus:execute-silent(hidex-theme preview {2})') || { restore; exit 0; }
    name=$(printf '%s' "$choice" | cut -f2)
    case $name in
      '') restore ;;
      reset) "$0" reset ;;
      *) "$0" "$name" ;;
    esac ;;
  # kept for the session, and for the project's next sessions (HIDEX_PROJECT)
  *) paint "$1" && echo "$1" > "$s/theme" && { [ -z "$HIDEX_PROJECT" ] || echo "$1" > "$HIDEX_PROJECT/theme"; } ;;
esac
case $1 in preview|off) ;; *) hidex-msg status >/dev/null 2>&1 ;; esac
