#!/bin/sh
# hidex-theme NAME | pick | reset | list | apply | preview NAME: recolours the terminal window hIDEx runs in,
# live. Every hIDEx colour is one of the terminal's 16, so zellij, Helix (unless given its own theme), the
# trees, lazygit and pudb all follow (Claude Code keeps its own). It writes the terminal's colour-setting
# sequences straight to the window (its tty, noted by hidex), past zellij. Schemes: iTerm2-Color-Schemes'
# kitty files (share/hidex/themes). pick: favourites, then every dark and light scheme, previewed as you move.
# reset: the terminal's own colours. apply: the session's theme again (hidex does it on reattach).
themes=$HIDEX_SHARE/themes
FAVOURITES='Atom One Dark
Dracula
Catppuccin Mocha
TokyoNight
Nord
Gruvbox Dark
Rose Pine
Catppuccin Latte
One Half Light
Gruvbox Light'

case ${1:-list} in
  list) ls "$themes" | sed -n 's/\.conf$//p'; exit ;;
esac
if [ "$1" = apply ]; then s=$(hidex-state "$2"); else s=$(hidex-state); fi || exit 1
tty=$(cat "$s/tty" 2>/dev/null) && [ -w "$tty" ] || { echo "hIDEx: no window to recolour" >&2; exit 1; }
osc() { printf '\033]%s\033\\' "$1" >> "$tty"; }
reset() { osc 104; osc 110; osc 111; osc 112; osc 117; osc 119; }

# paint NAME: the scheme's colours to the window (kitty format: "colorN #hex", "background #hex"…)
paint() {
  f=$themes/$1.conf
  [ -f "$f" ] || { echo "hIDEx: no theme $1 (hidex-theme list)" >&2; return 1; }
  reset
  while read -r k c; do
    case $k in
      color[0-9]*) osc "4;${k#color};$c" ;;
      foreground) osc "10;$c" ;;
      background) osc "11;$c" ;;
      cursor) osc "12;$c" ;;
      selection_background) osc "17;$c" ;;
      selection_foreground) osc "19;$c" ;;
    esac
  done < "$f"
}
# back to the session's theme, or the terminal's own colours
restore() { if [ -f "$s/theme" ]; then paint "$(cat "$s/theme")"; else reset; fi; }

# the list for fzf: group headers, then names; the hidden 2nd field is the scheme to preview (empty on headers)
listing() {
  h() { printf '\033[1;33m── %s\033[0m\t\n' "$1"; }
  printf '  reset (the terminal'"'"'s own colours)\treset\n'
  h favourites; printf '%s\n' "$FAVOURITES" | awk '{ print "  " $0 "\t" $0 }'
  # dark or light from the background's brightness
  awk '/^background/ { h = substr($2, 2); r = strtonum("0x" substr(h, 1, 2)); g = strtonum("0x" substr(h, 3, 2))
         b = strtonum("0x" substr(h, 5, 2)); n = FILENAME; sub(/.*\//, "", n); sub(/\.conf$/, "", n)
         print ((r * 299 + g * 587 + b * 114 > 128000) ? "light" : "dark") "\t" n }' "$themes"/*.conf |
    sort -t "$(printf '\t')" -k1,1 -k2,2f |
    awk -F'\t' '$1 != last { printf "\033[1;33m── %s\033[0m\t\n", $1; last = $1 } { print "  " $2 "\t" $2 }'
}

case $1 in
  reset) reset; rm -f "$s/theme" ${HIDEX_PROJECT:+"$HIDEX_PROJECT/theme"} ;;
  apply) [ -f "$s/theme" ] && paint "$(cat "$s/theme")" ;;
  preview) case $2 in reset) reset ;; '') ;; *) paint "$2" ;; esac ;;
  pick)
    choice=$(listing | fzf --ansi --no-sort --prompt 'theme > ' --delimiter '\t' --with-nth 1 \
      --height 100% --reverse --header 'moving previews; Enter keeps, Esc goes back' \
      --bind 'focus:execute-silent(hidex-theme preview {2})') || { restore; exit 0; }
    name=$(printf '%s' "$choice" | cut -f2)
    case $name in
      '') restore ;;
      reset) "$0" reset ;;
      *) "$0" "$name" ;;
    esac ;;
  # kept for the session, and for the project's next sessions (HIDEX_PROJECT)
  *) paint "$1" && echo "$1" > "$s/theme" && { [ -z "$HIDEX_PROJECT" ] || echo "$1" > "$HIDEX_PROJECT/theme"; } ;;
esac
[ "$1" = preview ] || hidex-msg status >/dev/null 2>&1
