#!/bin/sh
# The yazi pop-up, sandboxed like the trees but able to change the project (hidex-sandbox write): it cannot
# wander into other folders. Files open through hidex-open, which reaches Helix and lnav through zellij.
hidex-popup-colors
hidex-guard "$PWD" || { sleep 5; exit 1; }
export EDITOR=hidex-open
exec hidex-sandbox write "$PWD" -- yazi "$PWD"
