#!/bin/sh
# tidex-check-update (bin/tidex, at start): when a newer tIDEx is released, says so with its changes and asks; y
# installs it (its install.sh) and exits 10, so the launcher starts the new one. N: asked again next start.
# GitHub is asked at most once a day (the answer kept in ~/.cache/tidex), for 2 s at most; offline, nothing is
# said. Only in a terminal, for a released version (not a build from the repo). TIDEX_NO_UPDATE_CHECK=1: never.
repo=giorgoskouroupis/tidex
raw=https://raw.githubusercontent.com/$repo
[ -z "${TIDEX_NO_UPDATE_CHECK:-}" ] && [ -t 0 ] || exit 0
have=$(cat "$TIDEX_HOME/VERSION" 2>/dev/null)
case $have in v[0-9]*) ;; *) exit 0 ;; esac

# the latest release, asked once a day
cache=${XDG_CACHE_HOME:-$HOME/.cache}/tidex/latest
if [ -z "$(find "$cache" -mmin -1440 2>/dev/null)" ]; then
  mkdir -p "${cache%/*}"
  latest=$(curl -fsS --max-time 2 "https://api.github.com/repos/$repo/releases/latest" 2>/dev/null |
    sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1)
  [ -n "$latest" ] && echo "$latest" > "$cache"
fi
latest=$(cat "$cache" 2>/dev/null)
[ -n "$latest" ] && [ "$latest" != "$have" ] || exit 0
[ "$(printf '%s\n%s\n' "$have" "$latest" | sort -V | tail -1)" = "$latest" ] || exit 0

# what changed since this version (its CHANGELOG sections), and whether zellij changes (sessions then need a
# restart to use it)
changes=$(curl -fsS --max-time 2 "$raw/$latest/CHANGELOG.md" 2>/dev/null | awk -v have="[$have]" '
  $1 == "##" && $2 == have { exit } $1 == "##" && $2 != "[Unreleased]" { on = 1 } on')
zellij() { awk -F'\t' '$1 == "zellij" { print $2 }'; }
new_zellij=$(curl -fsS --max-time 2 "$raw/$latest/tools.lock" 2>/dev/null | zellij)
old_zellij=$(zellij < "$TIDEX_HOME/tools.lock")

printf '\ntIDEx %s is available (you have %s).\n' "$latest" "$have"
[ -n "$changes" ] && printf '%s\n' "$changes" | head -40 | sed 's/^/  /'
if [ -n "$new_zellij" ] && [ "$new_zellij" != "$old_zellij" ]; then
  printf '\n  It brings zellij %s (now %s): running sessions keep working on their own version; to use the new\n' \
    "$new_zellij" "$old_zellij"
  printf '  one, quit them and start them again (what still runs in their terminals is then stopped).\n'
fi
answer=$(tidex-key --yn --esc "$(printf '\nUpdate now? y/n (Esc: no) ')"); echo
[ "$answer" = y ] || exit 0
curl -fsSL "$raw/$latest/install.sh" | TIDEX_VERSION=$latest sh || exit 0
exit 10
