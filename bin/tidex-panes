#!/bin/sh
# tidex-panes: the session's panes, from zellij's list; every lookup in tIDEx's scripts goes through here.
#   tidex-panes [term|side]  the terminals ("term"), side terminals ("side") or both, one "ID<TAB>NAME" line each,
#                            the name as shown ("zsh 2"): the bar names them after what runs, a side terminal's
#                            name ending with an invisible mark (plugin/src/names.rs); "term N" / "side N" before
#   tidex-panes id TITLE     the terminal pane of that title (the editor's: "Neovim")
#   tidex-panes guest        the guest editor holding the editor's place (tidex-open-with), "ID<TAB>TITLE"
#   tidex-panes wait ID exited|gone [SECONDS]  until pane ID's command has exited, or the pane has gone
#                            (default 120 s); fails when it has not by then
# zellij's columns (list-panes -s): ID, TYPE, TITLE, FOCUSED, FLOATING, EXITED
list() { zellij action list-panes -s 2>/dev/null; }
# a pane's state: running, exited or gone
state() { list | awk -F'  +' -v p="$1" '$1 == p { s = ($6 == "true" ? "exited" : "running") } END { print s ? s : "gone" }'; }

case ${1:-} in
  id) list | awk -F'  +' -v t="$2" '$2 == "terminal" && $3 == t { print $1; exit }' ;;
  guest) list | awk -F'  +' '$2 == "terminal" && $3 ~ /^edit: / { print $1 "\t" $3; exit }' ;;
  wait)
    for _ in $(seq $((${4:-120} * 2))); do [ "$(state "$2")" = "$3" ] && exit 0; sleep 0.5; done
    exit 1 ;;
  *)
    mark=$(printf '\342\200\213')
    list | awk -F'  +' -v want="${1:-all}" -v mark="$mark" '
      NR > 1 && $2 == "terminal" && $5 == "false" && $6 != "true" {
        t = $3
        side = substr(t, length(t) - length(mark) + 1) == mark
        if (side) t = substr(t, 1, length(t) - length(mark))
        if (t !~ /^[^ :]+ [0-9]+$/) next
        if (t ~ /^side /) side = 1
        if (want == "all" || want == (side ? "side" : "term")) print $1 "\t" t
      }' ;;
esac
