#!/bin/sh
# hidex [--side claude|shell|none] [host:]path [more paths]: hIDEx in path, as a zellij session named after
# it. Every path gets its own tree (stacked), locked to it; Helix, the shell and the side terminal work in
# the first one. --side: what the side terminal starts with (default: Claude if installed), or no side pane.
# A live session (window closed, ssh dropped) is reattached; a dead one is replaced, not revived.
# hidex --version; hidex --uninstall removes hIDEx and everything it brought (hidex-uninstall).
# host:path runs the server's hIDEx there (the other paths are then on the server too).
side=claude
[ "$1" = --side ] && { side=$2; shift 2; }
case ${1:-.} in
  *:*) h=${1%%:*} d=${1#*:}; shift
       exec ssh -t "$h" "cd $d && if [ -x ~/.local/bin/hidex ]; then exec ~/.local/bin/hidex --side $side . $*;
         else echo 'hIDEx is not installed here: curl -fsSL https://raw.githubusercontent.com/giorgoskouroupis/hidex/main/install.sh | sh'; fi" ;;
esac

# hIDEx's own folder (this script's, links followed): its scripts and tools come first, its settings are used
HIDEX_HOME=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
h=$HIDEX_HOME
PATH=$h/bin:$h/tools/bin:$PATH HIDEX_SHARE=$h/share/hidex HIDEX_PLUGIN=$h/share/hidex/hidex-panes.wasm
LG_CONFIG_FILE=$h/share/hidex/lazygit.yml YAZI_CONFIG_HOME=$h/share/hidex/xdg/yazi ZELLIJ_CONFIG_DIR=$h/share/hidex
# pudb for breakpoint() and python -m pudb in any env (share/hidex/python/sitecustomize.py)
PYTHONPATH=$h/share/hidex/python${PYTHONPATH:+:$PYTHONPATH} PYTHONBREAKPOINT=pudb.set_trace
export HIDEX_HOME PATH HIDEX_SHARE HIDEX_PLUGIN LG_CONFIG_FILE YAZI_CONFIG_HOME ZELLIJ_CONFIG_DIR
export PYTHONPATH PYTHONBREAKPOINT
case ${1:-} in
  --version) cat "$h/VERSION"; exit ;;
  --uninstall) shift; exec hidex-uninstall "$@" ;;
esac
# a newer release: offered (hidex-check-update); installed, the new one starts instead
hidex-check-update
if [ $? = 10 ]; then exec "${HIDEX_PREFIX:-$HOME/.local}/bin/hidex" "$@"; fi
hidex-guard "${1:-.}" "$@" || exit 1
cd "${1:-.}" || exit 1
[ $# -gt 0 ] && shift
# named after the folder and its parent (e.g. code-myproject): two folders with the same name do not collide
n=$(basename "$(dirname "$PWD")")-$(basename "$PWD")
export HIDEX_SIDE=$side
# every pane, pop-up and command of the session (the plugin's too) finds its session here: no script takes it
# as an argument
export ZELLIJ_SESSION_NAME=$n
# what is kept for the project between sessions (themes, the Python picked), in ~/.local/state
HIDEX_PROJECT=${XDG_STATE_HOME:-$HOME/.local/state}/hidex/projects/$n-$(printf %s "$PWD" | md5sum | cut -c1-8)
export HIDEX_PROJECT
mkdir -p "$HIDEX_PROJECT"
s=$(hidex-state)
# the window's terminal, for live colour themes (hidex-theme); reset to its own colours when hIDEx ends
tty > "$s/tty" 2>/dev/null || rm -f "$s/tty"
end() { hidex-theme off; }
# zellij from outside the session: with its name set, zellij takes us for inside it, and refuses to delete it
# or attach to it
outside() { env -u ZELLIJ_SESSION_NAME zellij "$@"; }
case $(outside ls -n 2>/dev/null | grep "^$n ") in
  *EXITED*) outside delete-session --force "$n" >/dev/null 2>&1 ;;
  ?*) running=1 ;;
esac
# a running session: one from an older hIDEx first moves to this one, as /update does (so nothing in it keeps
# needing the old one); one that cannot move (another zellij, or from before /update) is offered for removal,
# else attached as it is
# with the session's own zellij: a newer one may refuse to talk to its older server
attach() {
  z=$s/current/tools/bin/zellij; [ -x "$z" ] || z=zellij
  # messages to its bar at its own address (the one through its "current" link)
  HIDEX_PLUGIN=$s/current/share/hidex/hidex-panes.wasm hidex-theme apply
  env -u ZELLIJ_SESSION_NAME "$z" attach "$n"; end; exit
}
if [ -n "$running" ]; then
  [ "$(readlink -f "$s/current")" = "$HIDEX_HOME" ] && attach
  hidex-update "$HIDEX_HOME" >/dev/null 2>&1 && attach
  printf 'The session "%s" runs an older hIDEx that cannot be updated in place (its zellij differs, or it is from\nbefore /update).\n  y  remove it and start fresh (its running commands stop, unsaved Helix files are lost)\n  N  open it as it is (the default): finish your work, then quit and start hIDEx again\n> ' "$n"
  read -r answer
  [ "$answer" = y ] || attach
  outside kill-session "$n" >/dev/null 2>&1; outside delete-session --force "$n" >/dev/null 2>&1
fi

# a new session reaches its hIDEx through $s/current, which /update (hidex-update) moves to a newer one without
# a restart: every path to this hIDEx below goes through that link instead
c=$s/current
ln -sfn "$HIDEX_HOME" "$c"
swap() { printf '%s' "$1" | sed "s|$HIDEX_HOME|$c|g"; }
PATH=$(swap "$PATH") PYTHONPATH=$(swap "$PYTHONPATH") LG_CONFIG_FILE=$(swap "$LG_CONFIG_FILE")
YAZI_CONFIG_HOME=$(swap "$YAZI_CONFIG_HOME") HIDEX_SHARE=$c/share/hidex HIDEX_PLUGIN=$c/share/hidex/hidex-panes.wasm
ZELLIJ_CONFIG_DIR=$s/config
export PATH PYTHONPATH LG_CONFIG_FILE YAZI_CONFIG_HOME HIDEX_SHARE HIDEX_PLUGIN ZELLIJ_CONFIG_DIR
hidex-config "$s"
hidex-zellij-setup

# the plugin runs in the bar, where zellij cannot ask for its permissions: approve them for this session's
# path (the same across /update), the same list as the plugin asks for (plugin/src/main.rs). The entry is
# written anew each start, so a permission added later is approved too; entries of hIDEx builds from before the
# session link go.
p=${XDG_CACHE_HOME:-$HOME/.cache}/zellij/permissions.kdl
mkdir -p "${p%/*}"; touch "$p"
awk -v this="\"$HIDEX_PLUGIN\" {" '$0 == this || /^"\/nix\/store\/[^"]*-hidex-panes-[^"]*" \{/ { skip = 1; next }
  skip && /^\}/ { skip = 0; next } !skip' "$p" > "$p.new"
printf '"%s" {\n' "$HIDEX_PLUGIN" >> "$p.new"
for permission in ReadApplicationState ChangeApplicationState RunCommands WriteToStdin ReadCliPipes; do
  printf '    %s\n' "$permission"
done >> "$p.new"
echo "}" >> "$p.new"
mv "$p.new" "$p"

# the project's window theme, else the terminal's own; the Python (hidex-python detect)
if [ -f "$HIDEX_PROJECT/theme" ]; then cp "$HIDEX_PROJECT/theme" "$s/theme"; hidex-theme apply; else rm -f "$s/theme"; fi
hidex-python detect
# the layout with one tree per folder, stacked; the first (code) tree is the open one
trees=$(x=" expanded=true"; for d in "$PWD" "$@"; do d=$(cd "$d" && pwd) || exit 1
  printf 'pane name="tree: %s" command="hidex-tree"%s { args "%s"; }\n' "$(basename "$d")" "$x" "$d"; x=; done) || exit 1
layout=$s/layout.kdl
awk -v t="$trees" -v side="$side" -v plugin="$HIDEX_PLUGIN" '/@TREES@/ && !/\/\// { print t; next }
  side == "none" && /name="side 1"/ { next } side == "none" { sub(/ size="60%"/, "") } { gsub(/@plugin@/, plugin); print }' \
  "$HIDEX_SHARE/layouts/hidex.kdl" > "$layout"
zellij -s "$n" -n "$layout"
end
