#!/usr/bin/env bash
# tests/installed [ARCHIVE]: tIDEx as a user gets it, for the tests: the archive (default: scripts/release of this
# checkout, as version "test") installed by install.sh into dist/test-install (downloads from dist/cache when
# there). Prints the installed version's folder.
set -euo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
archive=${1:-$("$repo/scripts/release" test)}
prefix=$repo/dist/test-install
# (never a PATH line in your shell's files for a test install)
TIDEX_ARCHIVE=$archive TIDEX_PREFIX=$prefix TIDEX_CACHE=$repo/dist/cache TIDEX_NO_MODIFY_PATH=1 sh "$repo/install.sh" >&2
readlink -f "$prefix/bin/tidex" | sed 's|/bin/tidex$||'
