#!/usr/bin/env bash
# tests/run [HIDEX]: hIDEx's tests. Each starts hIDEx in a hidden session (no window: keys go in through a fake
# terminal), drives it with keys and messages, and checks the panes zellij reports. Everything lives in its own
# temporary folders (runtime, state, cache, the project), never in your sessions or settings, so it is safe to
# run in the background. HIDEX: an installed hIDEx (default: tests/installed). Exit status: failed tests.
set -u
repo=$(cd "$(dirname "$0")/.." && pwd)
out=${1:-$("$repo/tests/installed")} || exit 1
Z=$out/tools/bin/zellij
T=$(mktemp -d "${TMPDIR:-/tmp}/hidex-tests.XXXXXX")
# zellij's sockets need a short path (Unix sockets allow ~100 characters): its runtime folder goes in the
# system's, still a separate one
R=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/hidex-tests.XXXXXX")
mkdir -p "$T/proj" && chmod 700 "$R"
export XDG_RUNTIME_DIR=$R XDG_STATE_HOME=$T/state XDG_CACHE_HOME=$T/cache
export SHELL=${BASH:-/bin/sh}  # plain shells, not your login setup
git -C "$T/proj" init -q && echo 'print("hi")' > "$T/proj/a.py"
S=$(basename "$T")-proj
failed=0
# a session that died must fail its checks, not stop the run when keys can no longer be written
trap "" PIPE

ok() { printf '  ok    %s\n' "$1"; }
fail() { printf '  FAIL  %s\n' "$1"; failed=$((failed + 1)); }
check() { if eval "$2"; then ok "$1"; else fail "$1"; fi; }
pause() { timeout "$1" tail -f /dev/null; }
# the panes as "title|focused|floating|rows" lines
panes() { "$Z" -s "$S" action list-panes -s -g 2>/dev/null | awk -F'  +' 'NR > 1 && $2 == "terminal" { print $3 "|" $4 "|" $5 "|" $9 }'; }
titles() { panes | cut -d'|' -f1 | tr '\n' ';'; }
# the focused pane's title: the test window's own (zellij's list of windows), not the panes' "focused" flags,
# which also count windows that have gone
focused() { local id; id=$("$Z" -s "$S" action list-clients 2>/dev/null | awk 'NR == 2 { print $2 }')
  "$Z" -s "$S" action list-panes 2>/dev/null | awk -F'  +' -v id="$id" '$1 == id { print $3 }'; }
has() { titles | grep -q "$1;"; }
count() { titles | tr ';' '\n' | grep -c "^$1"; }
rows() { panes | awk -F'|' -v t="$1" '$1 == t { print $4 }'; }
key() { printf '%b' "$1" >&3; pause "${2:-1.5}"; }
# (a message the bar never answers fails its check rather than stalling the run)
msg() { timeout 10 "$Z" -s "$S" pipe --name "hidex:$1" -- "${2:--}"; pause 2; }
in_session() { "$Z" -s "$S" run --close-on-exit --floating --name test -- "$@" >/dev/null; pause 2; }
wait_for() { local i; for i in $(seq 40); do eval "$1" && return 0; pause 0.25; done; return 1; }
# what a pane shows (its screen), by title
screen() { local id; id=$("$Z" -s "$S" action list-panes | awk -F'  +' -v t="$1" '$3 == t { print $1 }' | head -1)
  [ -n "$id" ] && "$Z" -s "$S" action dump-screen --pane-id "$id"; }

start() {
  rm -f "$T/keys"; mkfifo "$T/keys"
  (cd "$T/proj" && timeout 300 script -qfc "stty rows 42 cols 160; $out/bin/hidex --side shell ." /dev/null \
     < "$T/keys" > "$T/screen.log" 2>&1 &)
  exec 3> "$T/keys"
  wait_for 'has Helix && has "term 1"' && pause 2
}
stop() { exec 3>&-; "$Z" kill-session "$S" >/dev/null 2>&1; "$Z" delete-session "$S" >/dev/null 2>&1; pause 1; }
# the copied hIDEx (update test) keeps the store's read-only folders
trap 'stop; chmod -R u+w "$T" 2>/dev/null; rm -rf "$T" "$R"' EXIT

echo "hIDEx tests ($out)"

echo "start"
start
check "layout: tree, Helix, term 1, side 1" 'has "tree: proj" && has Helix && has "term 1" && has "side 1"'
check "running hidex again attaches to the live session" '! (cd "$T/proj" && timeout 4 script -qfc "stty rows 42 cols 160; $out/bin/hidex --side shell ." /dev/null </dev/null 2>&1) | grep -q "panicked\|not supported" && has Helix'
# (until that second window has gone, zellij may still count it: a focus change could land there)
wait_for '[ "$("$Z" -s "$S" action list-clients 2>/dev/null | tail -n +2 | wc -l)" = 1 ]'; pause 1

echo "new panes"
msg new terminal
check "a script message opens exactly one terminal" '[ "$(count "term ")" = 2 ]'
key '\x1bt'; key '\x1bn'
check "Alt+n on a terminal: a new term" '[ "$(count "term ")" = 3 ] && [ "$(focused)" = "term 3" ]'
key '\x1bh'; key '\x1bn'
check "Alt+n on Helix: a new term" '[ "$(count "term ")" = 4 ]'
key '\x1bc'; key '\x1bn'
check "Alt+n on a side terminal: a new side" '[ "$(count "side ")" = 2 ] && [ "$(focused)" = "side 2" ]'

echo "jumps and focus"
key '\x1bt'; key '\x1b2'
check "Alt+2 on a terminal: term 2" '[ "$(focused)" = "term 2" ]'
"$Z" -s "$S" action write-chars 'exit
'; pause 3
check "exiting term 2: the focus stays in the stack (term 3)" '! has "term 2" && [ "$(focused)" = "term 3" ]'
key '\x1b1'
check "Alt+1: term 1" '[ "$(focused)" = "term 1" ]'

echo "fold"
key '\x1bh'; before=$(rows Helix); full=$(rows "tree: proj")
key '\x1bx' 4
folded=$(panes | awk -F'|' '$1 == "Helix" { print $4 }')
key '\x1bx' 4
check "Alt+x folds Helix and unfolds it to its size" '[ -n "$before" ] && [ "$(rows Helix)" = "$before" ]'

echo "pop-ups"
key '\x1bg' 5
check "Alt+g opens lazygit" 'has "lazygit (read-only)"'
key 'q' 3
check "q closes it" '! has "lazygit (read-only)"'

echo "command palette"
n=$(count "term ")
key '\x1bp' 3; key 'term' 2; key '\r' 3
check "Alt+p, term, Enter: the suggested terminal opens" '[ "$(count "term ")" = $((n + 1)) ] && ! has commands'
key '\x1bp' 3; key '\x1b' 2
check "Esc closes the palette" '! has commands && [ "$(count "term ")" = $((n + 1)) ]'

echo "copy"
key '\x1bt'; "$Z" -s "$S" action write-chars 'echo hidex-copy-marker
'; pause 1
msg copy; pause 2
check "/copy takes the terminal's last command and its output" '[ "$("$out/bin/hidex-copy" --from "$XDG_RUNTIME_DIR/hidex/$S/copy.txt" | tail -1)" = hidex-copy-marker ] && "$out/bin/hidex-copy" --from "$XDG_RUNTIME_DIR/hidex/$S/copy.txt" | head -1 | grep -q "echo hidex-copy-marker"'

echo "memory"
in_session "$out/bin/hidex-theme" Dracula
check "a window theme is kept for the project" 'grep -qx Dracula "$XDG_STATE_HOME"/hidex/projects/*/theme'
mkdir -p "$T/venv/bin" && printf '#!/bin/sh\n' > "$T/venv/bin/python" && chmod +x "$T/venv/bin/python"
in_session "$out/bin/hidex-python" set "$T/venv"
check "a Python picked is kept for the project" 'grep -qx "$T/venv" "$XDG_STATE_HOME"/hidex/projects/*/python'
in_session "$out/bin/hidex-helix-theme" dracula
check "a Helix theme is kept for the project" 'grep -qx dracula "$XDG_STATE_HOME"/hidex/projects/*/helix-theme'

echo "update"
key '\x1bh'; "$Z" -s "$S" action write-chars 'ohello unsaved'; "$Z" -s "$S" action write 27; pause 1
cp -rs "$out" "$T/next"
in_session "$out/bin/hidex-update" "$T/next"
check "the session's hIDEx moves to the newer one" '[ "$(readlink "$XDG_RUNTIME_DIR/hidex/$S/current")" = "$T/next" ]'
check "terminals and Helix stay" 'has Helix && has "term 1" && has "term 3" && has "side 2"'
check "Helix keeps its unsaved text" 'screen Helix | grep -q "hello unsaved"'
n=$(count "term ")
msg new terminal
check "the reloaded bar still answers" '[ "$(count "term ")" = $((n + 1)) ]'
(cd "$T/proj" && timeout 5 script -qfc "stty rows 42 cols 160; $out/bin/hidex --side shell ." /dev/null </dev/null >/dev/null 2>&1)
check "attaching from another hIDEx moves the session to it" '[ "$(readlink -f "$XDG_RUNTIME_DIR/hidex/$S/current")" = "$(readlink -f "$out")" ] && has Helix'

echo "reattach"
# the window closes (as closing the terminal does) and a new one attaches: the keys must act in the new one
exec 3>&-; pkill -f "script -qfc stty rows 42 cols 160; $out/bin/hidex --side shell ."; pause 2
start
key '\x1bh'
check "after a reattach, Alt+h reaches Helix" '[ "$(focused)" = Helix ]'
n=$(count "term ")
key '\x1bt'; key '\x1bn' 3
check "and Alt+n opens exactly one terminal, focused" '[ "$(count "term ")" = $((n + 1)) ] && focused | grep -q "^term "'

echo "quit"
key '\x1bq' 4
check "Alt+q asks" 'has "quit?"'
key 'x' 2
check "another key cancels" '! has "quit?" && has Helix'
key '\x1bt'; "$Z" -s "$S" action write-chars 'sleep 300
'; pause 1
key '\x1bQ' 10
check "Alt+Shift+q ends the session" '! "$Z" ls -n 2>/dev/null | grep -q "^$S .*" || "$Z" ls -n 2>/dev/null | grep -q "^$S .*EXITED"'
check "and stops what ran in it" '! pgrep -f "^sleep 300$" >/dev/null'
# the ended session is left to hidex, as after a real quit
exec 3>&-; pause 1

echo "next session"
start
check "an ended session is replaced, not revived" 'has Helix && ! screen Helix | grep -q "Waiting to run"'
check "the project's Python comes back" 'grep -qx "$T/venv" "$XDG_RUNTIME_DIR/hidex/$S/python"'
check "the project's window theme comes back" 'grep -qx Dracula "$XDG_RUNTIME_DIR/hidex/$S/theme"'
msg helix theme
check "the project's Helix theme comes back" 'wait_for "screen Helix | grep -q dracula"'
stop

echo "Helix's sandbox"
mkdir -p "$T/home/.ssh" "$T/home/notes" && touch "$T/home/.ssh/id_test" "$T/home/notes/a"
check "hides ~/.ssh from Helix (empty, or refused)" 'seen=$(PATH="$out/bin:$out/tools/bin:$PATH" HOME=$T/home HIDEX_HELIX=ls "$out/bin/hidex-helix" -A "$T/home/.ssh" 2>/dev/null); [ -z "$seen" ]'
check "but not the rest" '[ "$(PATH="$out/bin:$out/tools/bin:$PATH" HOME=$T/home HIDEX_HELIX=ls "$out/bin/hidex-helix" "$T/home/notes")" = a ]'

echo "guard"
check "refuses /" '! "$out/bin/hidex-guard" / 2>/dev/null'
check "refuses ~/.ssh" '! "$out/bin/hidex-guard" "$HOME/.ssh" 2>/dev/null'
check "allows a project" '"$out/bin/hidex-guard" "$T/proj" 2>/dev/null'

echo "$failed failed"
exit "$failed"
