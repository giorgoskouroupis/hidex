#!/bin/sh
# Neovim's adapter (tidex-editor): run | close PANE | do VERB … | themes | health LANG | servers LANG | notes | title.
# Neovim answers other programs (--server, its remote API): the bar asks it through `do`, never by typing into it.
share=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
# its socket, in the session's sockets folder (the one place there an editor may write: tidex-sandbox editor)
sock() { echo "$(tidex-state)/sockets/nvim.sock"; }
# (a headless, clean client: no screen codes around its answers, and none of your own config)
ask() { timeout 5 nvim --headless --clean --server "$(sock)" "$@"; }
remote() { ask "$@" >/dev/null 2>&1; }
case $1 in
  # Neovim with tIDEx's settings (config/nvim) and state of its own (NVIM_APPNAME), listening on the session's
  # socket; sandboxed as every editor (tidex-sandbox editor), its own folders writable (undo history, shada).
  # TIDEX_EDITOR_RUN: another program (the tests).
  run)
    shift
    s=$(tidex-state 2>/dev/null) && { mkdir -p "$s/sockets"; rm -f "$(sock)"; }
    export NVIM_APPNAME=tidex-nvim
    own="${XDG_DATA_HOME:-$HOME/.local/share}/$NVIM_APPNAME:${XDG_STATE_HOME:-$HOME/.local/state}/$NVIM_APPNAME"
    # (made first: the sandbox allows writing in what exists)
    (IFS=:; mkdir -p $own)
    TIDEX_SANDBOX_WRITE=$own exec tidex-sandbox editor -- "${TIDEX_EDITOR_RUN:-nvim}" \
      ${s:+--listen "$(sock)"} -u "$share/nvim/init.lua" "$@" ;;
  # it quits, asking first what to do with unsaved files (save, drop, cancel); through its API, so not by its pane
  close) exec "$0" do quit ;;
  # the bar's verbs (plugin/src/editor.rs), as Neovim commands run in place (<Cmd>: whatever the mode)
  do)
    shift
    case $1 in
      open) shift; remote --remote "$@" ;;
      # changed files: untouched ones reloaded, the others ask (W12)
      reload | reload-all) remote --remote-send '<Cmd>checktime<CR>' ;;
      lsp-restart) remote --remote-send '<Cmd>lsp restart<CR>' ;;
      theme) remote --remote-send "<Cmd>colorscheme ${2:-}<CR>" ;;
      config-reload) remote --remote-send '<Cmd>source $MYVIMRC<CR>' ;;
      # refusing: Neovim asks what to do with unsaved files (save, drop, cancel)
      quit)
        case $2 in saving) c=wqa ;; dropping) c='qa!' ;; *) c='confirm qa' ;; esac
        remote --remote-send "<Cmd>$c<CR>" ;;
      # how many files have unsaved changes
      unsaved) ask --remote-expr "len(getbufinfo({'bufmodified':1}))" ;;
      # whether that file has unsaved changes here: 1 or 0 (open-with hands over only a saved file)
      modified) ask --remote-expr "getbufvar(bufnr(fnameescape('$2')), '&modified') ? 1 : 0" ;;
      *) echo "nvim do: open FILE… | reload | reload-all | lsp-restart | theme [NAME] | config-reload | quit [saving|dropping] | unsaved | modified FILE" >&2; exit 1 ;;
    esac ;;
  # Neovim's own scheme first (in the terminal's colours), then the others it brings
  themes)
    echo default
    ls "$(dirname "$(readlink -f "$(command -v nvim)")")/../share/nvim/runtime/colors" 2>/dev/null |
      sed -n 's/\.\(vim\|lua\)$//p' | grep -vx default | sort -u ;;
  # a language's servers, from config/nvim/lua/tidex/servers.lua: "✓ found ✘ missing", or "none"
  servers | health) nvim -l "$share/nvim/langs.lua" "$2" ;;
  # what nobody would guess about it (the welcome pop-up, Alt+k)
  notes) echo "Files changed on disk (Claude, git) come back by themselves; changed here too, Neovim asks which to keep (W12)"
    echo "Space: Helix's menu (files, search, symbols, diagnostics), shown as you type; Space ? lists every key" ;;
  title) echo Neovim ;;
  *) echo "usage: nvim run | close PANE | do VERB … | themes | health LANG | servers LANG | notes | title" >&2; exit 1 ;;
esac
