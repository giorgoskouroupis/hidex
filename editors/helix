#!/bin/sh
# Helix's adapter (tidex-editor): run | close PANE | themes | health LANG | servers LANG | notes | title. Helix
# has no interface for other programs: the bar types its commands into it (plugin/src/typist.rs), and it saves
# when left (its config: auto-save), the only way to hand files over safely.
case $1 in
  # Helix, sandboxed so it cannot open the secrets folders (tidex-sandbox machine), nor anything it starts
  # (language servers, :sh). TIDEX_EDITOR_RUN: another program to run there instead (the tests).
  run) shift; exec tidex-sandbox machine -- "${TIDEX_EDITOR_RUN:-hx}" "$@" ;;
  # it quits, typed into its pane: Esc alone first (Esc then ":" at once reads as Alt+:), then :quit-all, which
  # refuses while files are unsaved; Enter as a terminal sends it, \r (\n reaches Helix as Ctrl+j)
  close) zellij action write --pane-id "$2" 27; sleep 0.2; zellij action write-chars --pane-id "$2" "$(printf ':quit-all\r')" ;;
  # tIDEx's own first (in the window's colours), then every theme in Helix's runtime folders
  themes)
    echo tidex
    hx --health 2>/dev/null | sed -n 's/^Runtime directories: //p' | tr ';' '\n' |
      while read -r d; do ls "$d/themes" 2>/dev/null; done | sed -n 's/\.toml$//p' | sort -u ;;
  # Helix's report on a language
  health) hx --health "$2" ;;
  # its language servers, one line: "✓ found ✘ missing", or "none"
  servers)
    hx --health "$2" 2>/dev/null | awk '/^Configured language servers/ { on = 1; next } on && /^[^ ]/ { exit }
      on && /✓|✘/ { s = $0; sub(/^ *[^ ]* */, "", s); sub(/:.*/, "", s); printf "%s %s  ", ($0 ~ /✓/ ? "✓" : "✘"), s }
      on && /None/ { printf "none" }' ;;
  # what nobody would guess about it (the welcome pop-up, Alt+k)
  notes) echo "Helix saves by itself when you leave it (another pane, F2, a pop-up): nothing stays as an unsaved draft; u still undoes" ;;
  title) echo Helix ;;
  *) echo "usage: helix run | close PANE | themes | health LANG | servers LANG | notes | title" >&2; exit 1 ;;
esac
