// broot trees | Helix on top, a shell across both below, the side terminal right (Claude first, with
// --resume to pick a past conversation, then a shell for any AI tool), the hIDEx bar at the bottom.
// The last side terminal and the last shell come back when exited (bin/hidex-side, hidex-shell).
// Keys and pop-ups: ../config.kdl. bin/hidex fills in @TREES@ and drops the side pane with --side none.
layout {
    tab name="hIDEx" focus=true {
        pane split_direction="vertical" {
            pane size="60%" split_direction="horizontal" {
                pane size="72%" split_direction="vertical" {
                    // @TREES@: one locked tree per folder passed to hidex, stacked
                    pane stacked=true size="28%" {
                        @TREES@
                    }
                    pane name="Helix" command="hidex-helix" focus=true
                }
                pane name="term 1" command="hidex-shell"
            }
            pane name="side 1" command="hidex-side" size="40%" { args "--resume"; }
        }
        // the bar: the hIDEx plugin, which also does what the hIDEx keys ask
        pane size=1 borderless=true {
            plugin location="file:@plugin@"
        }
        // the welcome pop-up at a first start (bin/hidex fills it in, or nothing)
        @WELCOME@
    }
}
