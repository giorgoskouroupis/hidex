// hIDEx's zellij config. Locked by default, so every key reaches Helix, lazygit and Claude
// (Ctrl+g unlocks zellij's own modes); the Alt keys below work while locked.
default_mode "locked"
theme "hidex"
pane_frames true
// a full rounded frame around every pane (the default only draws a title line above each)
pane_frame_style "full"
show_startup_tips false
show_release_notes false
// plain segments in zellij's own UI (pop-up titles, prompts) instead of arrow-shaped ones
simplified_ui true
// stacks (the terminals, the side terminals) show their titles in a row, like tabs
stacked_pane_list_orientation "horizontal"
// stacks as a list (needed for the row of titles above)
stacked_pane_list true
// no browser access to sessions
web_server false
// no frame highlight on mouse hover, so a coloured frame always means focus
mouse_hover_effects false
ui {
    pane_frames {
        rounded_corners true
        hide_session_name true
    }
}

keybinds {
    // scroll mode (Alt+v) ends back in hIDEx's keys (locked mode), at the bottom: m after copying the command at the
    // top with its output (the shell marks them: OSC 133), Esc, Ctrl+c or q without
    scroll {
        bind "m" { SelectCommandAtScrollPosition; Copy; ScrollToBottom; SwitchToMode "Locked"; }
        bind "Esc" "Ctrl c" "q" { ScrollToBottom; SwitchToMode "Locked"; }
    }
    locked {
        bind "Alt Left" { MoveFocusOrTab "Left"; }
        bind "Alt Right" { MoveFocusOrTab "Right"; }
        bind "Alt Down" { MoveFocus "Down"; }
        bind "Alt Up" { MoveFocus "Up"; }
        // jump straight to a pane: the explorer, Helix, the terminals, the side terminal (Claude); the keys
        // below go to the hIDEx plugin, which lives in the bar (layouts/hidex.kdl)
        bind "Alt e" { MessagePlugin "file:@plugin@" { name "focus"; payload "tree"; }; }
        bind "Alt h" { MessagePlugin "file:@plugin@" { name "focus"; payload "helix"; }; }
        bind "Alt t" { MessagePlugin "file:@plugin@" { name "focus"; payload "terminals"; }; }
        bind "Alt c" { MessagePlugin "file:@plugin@" { name "focus"; payload "side"; }; }
        // Alt+1…9: term N, side N or the Nth tree, of the kind of pane you are on (from Helix: term N)
        bind "Alt 1" { MessagePlugin "file:@plugin@" { name "jump"; payload "1"; }; }
        bind "Alt 2" { MessagePlugin "file:@plugin@" { name "jump"; payload "2"; }; }
        bind "Alt 3" { MessagePlugin "file:@plugin@" { name "jump"; payload "3"; }; }
        bind "Alt 4" { MessagePlugin "file:@plugin@" { name "jump"; payload "4"; }; }
        bind "Alt 5" { MessagePlugin "file:@plugin@" { name "jump"; payload "5"; }; }
        bind "Alt 6" { MessagePlugin "file:@plugin@" { name "jump"; payload "6"; }; }
        bind "Alt 7" { MessagePlugin "file:@plugin@" { name "jump"; payload "7"; }; }
        bind "Alt 8" { MessagePlugin "file:@plugin@" { name "jump"; payload "8"; }; }
        bind "Alt 9" { MessagePlugin "file:@plugin@" { name "jump"; payload "9"; }; }
        // a new pane of the kind you are on, stacked with it: a terminal, or a side terminal (from Helix or a tree: a
        // terminal)
        bind "Alt n" { MessagePlugin "file:@plugin@" { name "new"; payload "here"; }; }
        bind "Alt f" "Shift Esc" { ToggleFocusFullscreen; }
        // zen: the focused pane covers the whole window, the bar too; the same key brings everything back
        bind "Alt z" { ToggleFocusNoUiFullscreen; }
        // an earlier command with its output, from the keyboard: zellij's scroll mode at the last command whose
        // prompt is off screen; [ and ] step through commands, m copies the one at the top with its command line
        bind "Alt v" { SwitchToMode "Scroll"; ScrollToPreviousPrompt; }
        // back to the pane you were in before
        bind "Alt \\" { FocusLastPane; }
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        // move one border: Alt+Shift+arrow grows the pane on that side, Alt+Ctrl+arrow shrinks it from that side
        bind "Alt Shift Left" { Resize "Increase Left"; }
        bind "Alt Shift Right" { Resize "Increase Right"; }
        bind "Alt Shift Up" { Resize "Increase Up"; }
        bind "Alt Shift Down" { Resize "Increase Down"; }
        bind "Alt Ctrl Left" { Resize "Decrease Left"; }
        bind "Alt Ctrl Right" { Resize "Decrease Right"; }
        bind "Alt Ctrl Up" { Resize "Decrease Up"; }
        bind "Alt Ctrl Down" { Resize "Decrease Down"; }
        bind "Alt w" { ToggleFloatingPanes; }
        // fold the focused pane to a strip (its neighbours cover it), or unfold it; jumping to it unfolds it too
        bind "Alt x" { MessagePlugin "file:@plugin@" { name "collapse"; }; }
        // the / commands: a line to type in, what fits listed below as you type (hidex-cmd)
        bind "Alt p" { MessagePlugin "file:@plugin@" { name "popup"; payload "commands"; }; }
        // quit hIDEx, asking first (hidex-quit-ask): Helix quits first, and refuses while files are unsaved
        bind "Alt q" { MessagePlugin "file:@plugin@" { name "quit"; payload "ask"; }; }
        // quit on the spot: unsaved changes dropped, running commands stopped
        bind "Alt Q" { MessagePlugin "file:@plugin@" { name "quit"; payload "now"; }; }
        // pop-ups: the same key opens, hides and shows it again. Alt+g: lazygit read-only; Alt+Shift+g: the
        // lazygit that can stage and commit (it replaces the read-only one)
        bind "Alt g" { MessagePlugin "file:@plugin@" { name "popup"; payload "lazygit (read-only)"; }; }
        bind "Alt G" { MessagePlugin "file:@plugin@" { name "popup"; payload "lazygit"; }; }
        bind "Alt y" { MessagePlugin "file:@plugin@" { name "popup"; payload "yazi"; }; }
    }
}

// Terminal colours by ANSI index (0 black .. 8 grey), so hIDEx follows the terminal's palette and its
// dark/light switch. Unfocused frames: a colour just off the background (filled in by hidex-config), so only the
// focused one stands out.
themes {
    hidex {
        text_unselected { base 7; background 0; emphasis_0 3; emphasis_1 6; emphasis_2 2; emphasis_3 5; }
        text_selected { base 7; background 8; emphasis_0 3; emphasis_1 6; emphasis_2 2; emphasis_3 5; }
        ribbon_selected { base 0; background 5; emphasis_0 1; emphasis_1 3; emphasis_2 6; emphasis_3 4; }
        ribbon_unselected { base 7; background 8; emphasis_0 1; emphasis_1 3; emphasis_2 6; emphasis_3 5; }
        table_title { base 5; background 0; emphasis_0 3; emphasis_1 6; emphasis_2 2; emphasis_3 4; }
        table_cell_selected { base 7; background 8; emphasis_0 3; emphasis_1 6; emphasis_2 2; emphasis_3 5; }
        table_cell_unselected { base 7; background 0; emphasis_0 3; emphasis_1 6; emphasis_2 2; emphasis_3 5; }
        list_selected { base 7; background 8; emphasis_0 3; emphasis_1 6; emphasis_2 2; emphasis_3 5; }
        list_unselected { base 7; background 0; emphasis_0 3; emphasis_1 6; emphasis_2 2; emphasis_3 5; }
        frame_selected { base 3; background 0; emphasis_0 3; emphasis_1 6; emphasis_2 2; emphasis_3 5; }
        frame_unselected { base 8; background 0; emphasis_0 3; emphasis_1 6; emphasis_2 2; emphasis_3 5; }
        frame_highlight { base 3; background 0; emphasis_0 3; emphasis_1 6; emphasis_2 2; emphasis_3 5; }
        exit_code_success { base 2; background 0; emphasis_0 3; emphasis_1 6; emphasis_2 2; emphasis_3 5; }
        exit_code_error { base 1; background 0; emphasis_0 3; emphasis_1 6; emphasis_2 2; emphasis_3 5; }
        multiplayer_user_colors { player_1 5; player_2 4; player_3 6; player_4 2; player_5 3; player_6 1; player_7 5; player_8 4; player_9 6; player_10 2; }
    }
}
